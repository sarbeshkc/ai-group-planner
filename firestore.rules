rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own data
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
    }
    
    // Group rules
    match /groups/{groupId} {
      // Allow read if user is a member of the group
      allow read: if request.auth != null && (
        resource.data.members[request.auth.uid] != null || 
        resource.data.members.hasAny([request.auth.uid])
      );
      
      // Allow create if authenticated
      allow create: if request.auth != null;
      
      // Allow update if user is the creator or a member
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.members[request.auth.uid] != null ||
        resource.data.members.hasAny([request.auth.uid])
      );
      
      // Only group creator can delete
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }
    
    // Plan rules
    match /plans/{planId} {
      // Allow read if user is a member of the associated group
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
        (
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members[request.auth.uid] != null ||
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members.hasAny([request.auth.uid])
        );
      
      // Allow create if user is a member of the group
      allow create: if request.auth != null && 
        exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)) &&
        (
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members[request.auth.uid] != null ||
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members.hasAny([request.auth.uid])
        );
      
      // Allow update if user is the creator or a member of the group
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
        (
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members[request.auth.uid] != null ||
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members.hasAny([request.auth.uid])
        )
      );
      
      // Only plan creator can delete
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }
    
    // Task rules - similar to plans
    match /tasks/{taskId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
        (
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members[request.auth.uid] != null ||
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members.hasAny([request.auth.uid])
        );
      
      allow create: if request.auth != null && 
        exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)) &&
        (
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members[request.auth.uid] != null ||
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members.hasAny([request.auth.uid])
        );
      
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid ||
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
        (
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members[request.auth.uid] != null ||
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members.hasAny([request.auth.uid])
        )
      );
      
      allow delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        exists(/databases/$(database)/documents/plans/$(resource.data.planId)) &&
        get(/databases/$(database)/documents/plans/$(resource.data.planId)).data.createdBy == request.auth.uid
      );
    }
    
    // Chat messages rules
    match /messages/{messageId} {
      // Allow read if user is a member of the group
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
        (
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members[request.auth.uid] != null ||
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members.hasAny([request.auth.uid])
        );
      
      // Allow create if user is a member of the group and the sender is the user
      allow create: if request.auth != null && 
        exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)) &&
        (
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members[request.auth.uid] != null ||
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members.hasAny([request.auth.uid])
        ) &&
        request.resource.data.sender == request.auth.uid;
      
      // Only message sender can update or delete their messages
      allow update, delete: if request.auth != null && resource.data.sender == request.auth.uid;
    }
  }
}